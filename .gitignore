__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
*.p

# raw analysis data (large HDF5 / npz), kept out of git
data/
# derived scan caches (large, regenerable via scripts/scan_grid.py); not versioned
notebooks/computation_cache/
notebooks/computation_cache_noatm/
# data release: only the CURRENT release cube is versioned. Superseded cubes
# (v1-v4) stay local/Zenodo-only so history does not carry a copy of each
# campaign; shards are build intermediates and never versioned.
release/*.h5
!release/luhdm_datarelease_v5.h5
release_shards*/
# scratch: cache/figure backups, working notes, anything not for git
/ignore/
