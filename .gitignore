__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
*.p

# raw analysis data (large HDF5 / npz), kept out of git
data/
# derived scan caches (large, regenerable via scripts/scan_grid.py); not versioned
notebooks/computation_cache/
notebooks/computation_cache_noatm/
# data release: only the CURRENT release cubes are versioned. Superseded cubes
# (v1-v4), the internal full-lambda parent (v5) and the v6 subset that was
# prepared but never published stay local/Zenodo-only so history does not carry
# a copy of each campaign; shards and assembly staging dirs are build
# intermediates and never versioned.
release/*.h5
!release/luhdm_datarelease_v7_A_f1_atm.h5
!release/luhdm_datarelease_v7_B_f0p1_noatm.h5
!release/luhdm_datarelease_v8_A_f1_atm.h5
!release/luhdm_datarelease_v8_B_f0p1_noatm.h5
# superseded by provenance_v7_A_f1_atm.json / provenance_v7_B_f0p1_noatm.json;
# it is the v5 parent's build record and stays local alongside that cube.
release/provenance.json
release_shards*/
release_v7quick/
# scratch: cache/figure backups, working notes, anything not for git
/ignore/
